# --- Email delivery for the "Join the Family" form ---
# Destination is always realestones@outlook.com (see app/api/join/route.ts).

# OPTION 1 (recommended): Resend — free tier at https://resend.com
# 1. Create a free account, verify your sending domain (or use onboarding domain to test).
# 2. Create an API key and paste it below.
# 3. Add these as Environment Variables in Vercel/Netlify (same names).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=The Realest Ones <noreply@yourdomain.com>

# OPTION 2 (no signup): FormSubmit fallback — used automatically when
# RESEND_API_KEY is not set. One-time activation required:
# submit the form once on the live site, then open realestones@outlook.com
# and click the FormSubmit activation link. Until then, signups are held.
